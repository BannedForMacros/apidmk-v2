# Plantilla sin credenciales. Copie este archivo como application.properties
# y complete los valores del cliente. El archivo real no se versiona: este
# repositorio es publico.

#CONEXIONES:

#SERVER / LOCAL
#LOCAL = solo usa SQL Server (ideal para entorno local dockerizado)
spring.modalidad=LOCAL

#################################################################################
#SERVER (NO se usa en modo LOCAL - se deja solo de referencia)
spring.datasource.url=jdbc:mysql://SERVIDOR:3306/BASE_DEL_CLIENTE?noAccessToProcedureBodies=true
spring.datasource.driver=com.mysql.jdbc.Driver
spring.datasource.username=CAMBIAR
spring.datasource.password=CAMBIAR


#################################################################################
#BASE DE DATOS DEL DATAMARKET
#SQLSERVER -> contenedor Docker local (alcanzado via host.docker.internal:1433)
spring.datasource.SQL.url=jdbc:sqlserver://host.docker.internal:1433;DatabaseName=db_travel;encrypt=false;trustServerCertificate=true;
spring.datasource.SQL.driver=com.microsoft.sqlserver.jdbc.SQLServerDriver
spring.datasource.SQL.username=CAMBIAR
spring.datasource.SQL.password=CAMBIAR

#################################################################################
#RUTA BASE DE DATOS DERBY
spring.datasource.DERBY.url=jdbc:derby:D:\\DATABASE\\POSM.db
